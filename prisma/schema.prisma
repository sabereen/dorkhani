generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RangeType {
  free
  juz
  hizbQuarter
  page
  surah
  ayah
}

enum KhatmStatus {
  inProgress
  completed
}

enum ReviewStatus {
  pending
  approved
  rejected
}

model TKhatmSeries {
  id        Int      @id
  maxRounds Int?     @map("max_rounds") @db.UnsignedSmallInt()
  khatms    TKhatm[]

  @@map("khatm_series")
}

model TKhatm {
  id           Int           @id @default(autoincrement())
  // عنوان
  title        String        @db.VarChar(100)
  // توضیحات
  description  String        @db.Text()
  // نوع بازه‌ی قابل انتخاب توسط کاربر
  rangeType    RangeType     @default(free) @map("range_type")
  // تعداد کل آیات خوانده شده از ختم را نگهداری می‌کند
  versesRead   Int           @default(0) @map("verses_read") @db.UnsignedSmallInt()
  // ختم خصوصی فقط با داشتن اکسس‌توکن مربوطه نمایش داده می‌شود و در صفحه اصلی نمایش داده نمی‌شود
  private      Boolean       @default(false)
  // توکن مربوط به ختم‌های خصوصی
  accessToken  String?       @map("access_token")
  // تاریخ ایجاد ختم
  created      DateTime      @default(now())
  // تاریخ پایان ختم
  endDate      DateTime?
  // وضعیت پیشرفت ختم
  status       KhatmStatus   @default(inProgress)
  // وضعیت تأیید ختم توسط مدیر
  reviewStatus ReviewStatus  @default(pending) @map("review_status")
  // شماره دور جاری در دنباله
  roundNumber  Int           @default(1) @map("round_number") @db.UnsignedSmallInt()
  // شناسه دنباله
  seriesId     Int?          @map("series_id")
  series       TKhatmSeries? @relation(fields: [seriesId], references: [id])
  parts        TKhatmPart[]

  @@index([reviewStatus])
  @@map("khatm")
}

model TZekr {
  id          Int      @id @default(autoincrement())
  // عنوان
  title       String   @db.VarChar(100)
  // توضیحات
  description String   @db.Text()
  // متن ذکر مورد نظر
  zekrText    String?  @map("zekr_text") @db.Text()
  // تعداد مرتبه‌ی خوانده شده از ذکر را نگهداری می‌کند
  count       Int      @default(0) @map("count") @db.UnsignedInt()
  // تعداد ذکر هدف این ختم
  targetCount Int?     @map("target_count") @db.UnsignedInt()
  // تاریخ ایجاد ختم
  created     DateTime @default(now())

  @@map("zekr")
}

model TKhatmPart {
  id      Int      @id @default(autoincrement())
  khatm   TKhatm   @relation(fields: [khatmId], references: [id])
  khatmId Int      @map("khatm_id")
  start   Int      @db.UnsignedSmallInt()
  end     Int      @db.UnsignedSmallInt()
  created DateTime @default(now())

  @@map("khatm_part")
}

model TAppSettings {
  id     Int  @id @default(1)
  config Json

  @@map("app_settings")
}
